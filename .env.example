# Copy this file to ".env" and paste your real key. NEVER commit .env to GitHub.

# Which AI to use: "gemini" (free key) or "claude" (paid key)
DOCUMIND_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# If you hit rate limits, try: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# Only needed if DOCUMIND_PROVIDER=claude
# ANTHROPIC_API_KEY=your-key-here
# DOCUMIND_MODEL=claude-sonnet-5-5
